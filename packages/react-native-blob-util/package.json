{
  "name": "@config-plugins/react-native-blob-util",
  "version": "14.0.3",
  "description": "Config plugin to auto configure react-native-blob-util on prebuild",
  "keywords": [
    "expo",
    "react-native",
    "react-native-blob-util"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/expo/config-plugins.git",
