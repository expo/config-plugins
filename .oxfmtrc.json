{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "**/.expo",
    "**/android",
    "**/ios",
    "**/dist",
    "node_modules",
    "**/expo-env.d.ts"
  ],
  "printWidth": 100,
  "tabWidth": 2,
  "singleQuote": true,
  "bracketSameLine": true,
  "trailingComma": "es5"
}
